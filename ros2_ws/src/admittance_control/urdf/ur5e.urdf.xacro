<?xml version="1.0"?>
<!--
  Clean UR5e xacro wrapper for sand_drawer project.
  Uses ur_description package for the base robot macro,
  parameterised specifically for UR5e.

  Usage:
    xacro ur5e.urdf.xacro

  Or from launch file:
    robot_description = Command(['xacro ', FindPackageShare('sand_drawer'), '/urdf/ur5e.urdf.xacro'])
-->
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="ur5e">

  <!-- Import the UR macro from ur_description -->
  <xacro:include filename="$(find ur_description)/urdf/ur_macro.xacro"/>

  <!-- World link (root) -->
  <link name="world"/>

  <!-- UR5e arm, mounted to world. Kinematics: the robot's FACTORY CALIBRATION
       (config/ur5e_calibration.yaml, extracted from the controller), not the nominal
       default_kinematics.yaml: the controller, RTDE and the hand-eye samples all use the
       calibrated chain; TF on the nominal one put the camera 0.55 deg / ~5 mm off at the
       scan home (measured 2026-09-29). -->
  <xacro:ur_robot
    name="ur5e"
    tf_prefix=""
    parent="world"
    joint_limits_parameters_file="$(find ur_description)/config/ur5e/joint_limits.yaml"
    kinematics_parameters_file="$(find admittance_control)/config/ur5e_calibration.yaml"
    physical_parameters_file="$(find ur_description)/config/ur5e/physical_parameters.yaml"
    visual_parameters_file="$(find ur_description)/config/ur5e/visual_parameters.yaml"
    safety_limits="false"
  >
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:ur_robot>

</robot>
