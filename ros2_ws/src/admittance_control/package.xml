<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>admittance_control</name>
  <version>1.0.0</version>
  <description>
    UR5e task-space plane extraction and trajectory preparation pipeline
    for Isaac Sim based admittance control workflows.
  </description>
  <maintainer email="cagdas96vkp@gmail.com">Cagdas</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <!-- Core ROS 2 dependencies -->
  <depend>rclcpp</depend>
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>

  <!-- Perception pipeline (SAM-6D bridge) -->
  <depend>vision_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>sensor_msgs_py</depend>
  <depend>std_srvs</depend>

  <!-- Colored pointcloud from rgb + aligned depth (pointcloud.launch.py) -->
  <exec_depend>depth_image_proc</exec_depend>
  <exec_depend>rclcpp_components</exec_depend>

  <!-- TF and utility dependencies for plane capture -->
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>

  <!-- Robot description -->
  <depend>robot_state_publisher</depend>
  <depend>joint_state_publisher</depend>
  <depend>xacro</depend>
  <depend>urdf</depend>

  <!-- Control -->
  <depend>controller_manager</depend>
  <depend>joint_trajectory_controller</depend>

  <!-- MoveIt (for Jacobian calculator) -->
  <depend>moveit_core</depend>
  <depend>moveit_ros_planning</depend>

  <!-- Action / service interfaces -->
  <depend>action_msgs</depend>
  <depend>trajectory_msgs</depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
