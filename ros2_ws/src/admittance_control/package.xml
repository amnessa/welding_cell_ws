<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>admittance_control</name>
  <version>1.0.0</version>
  <description>
    Vision-only robotic tack placement on a UR5e with a wrist RealSense: the
    parts are registered to their CAD (pose-server bridge, FoundationPose
    tracking, ICP, multi-view refinement), the weld seams and tacks are
    computed from the registered geometry (weld_generator), and the tacks are
    marked with a pen (collision model, planning, Cartesian descent). Also
    holds the earlier admittance-control and drawing pipeline.
  </description>
  <maintainer email="cagdas96vkp@gmail.com">Cagdas</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <!-- Core ROS 2 dependencies -->
  <depend>rclcpp</depend>
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>

  <!-- Perception pipeline (SAM-6D bridge) -->
  <depend>vision_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>sensor_msgs_py</depend>
  <depend>std_srvs</depend>

  <!-- Colored pointcloud from rgb + aligned depth (pointcloud.launch.py) -->
  <exec_depend>depth_image_proc</exec_depend>
  <exec_depend>rclcpp_components</exec_depend>
  <!-- _transit_cpp: OMPL's AnytimePathShortening + the collision model in C++ -->
  <depend>ompl</depend>
  <build_depend>pybind11-dev</build_depend>
  <!-- fp_tracker_node.py: WebSocket client to the laptop's FoundationPose tracker -->
  <exec_depend>python3-websocket</exec_depend>

  <!-- TF and utility dependencies for plane capture -->
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>

  <!-- Robot description -->
  <depend>robot_state_publisher</depend>
  <depend>joint_state_publisher</depend>
  <depend>xacro</depend>
  <depend>urdf</depend>

  <!-- Control -->
  <depend>controller_manager</depend>
  <exec_depend>controller_manager_msgs</exec_depend>  <!-- camera_aim_node: switch_controller -->
  <depend>joint_trajectory_controller</depend>

  <!-- MoveIt (for Jacobian calculator) -->
  <depend>moveit_core</depend>
  <depend>moveit_ros_planning</depend>

  <!-- Action / service interfaces -->
  <depend>action_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>control_msgs</depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
